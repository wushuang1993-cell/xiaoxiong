<view class="screen bears-screen">
  <view class="hero soft-card">
    <view class="hero-copy">
      <text class="muted">{{dateText}}</text>
      <view class="title">今晚小熊</view>
      <view class="chip">{{state.drawUsed ? '今日已抽签' : '今日未抽签'}}</view>
    </view>
    <view class="hero-art">
      <image class="hero-bear" src="{{heroBear.image}}" mode="aspectFit" />
    </view>
    <view class="wish-button" bindtap="openWishPicker">♡</view>
  </view>

  <view class="people-grid">
    <view class="person-card {{index === 0 ? 'pink' : 'green'}}" wx:for="{{state.people}}" wx:key="name">
      <view class="person-head">
        <view class="avatar-box">
          <image class="person-avatar" src="{{item.image}}" mode="aspectFit" />
        </view>
        <view>
          <text class="name">{{item.displayName || item.name}}</text>
          <text class="coin">{{item.chanceText}}</text>
        </view>
      </view>
      <view class="bear-row">
        <view class="mini-bear" wx:for="{{assignments[item.name]}}" wx:key="*this">
          <view class="mini-bear-art">
            <image src="{{bearMap[item].image}}" mode="aspectFit" />
          </view>
          <text>{{item}}</text>
        </view>
        <view class="empty-bear" wx:if="{{!assignments[item.name] || !assignments[item.name].length}}">未分配</view>
      </view>
    </view>
  </view>

  <button wx:if="{{!state.drawUsed}}" class="button draw-button" bindtap="handleDraw">开始抽签</button>
  <view wx:else class="action-row">
    <button class="button redraw-button" bindtap="requestRedraw">申请重抽</button>
    <button class="button exchange-button" bindtap="requestExchange">申请兑换</button>
  </view>

  <view wx:if="{{drawReminder}}" class="draw-reminder soft-card">
    <view>
      <text class="reminder-title">{{drawReminder.title}}</text>
      <text class="reminder-detail">{{drawReminder.detail}}</text>
    </view>
    <button class="reminder-button" bindtap="handleDraw">手动抽小熊</button>
  </view>

  <view class="recent-draw soft-card">
    <view class="recent-title">今天 / 昨天小熊</view>
    <view class="recent-day" wx:for="{{recentDrawDays}}" wx:for-item="day" wx:key="key">
      <view class="recent-day-head">
        <text>{{day.label}}</text>
        <text>{{day.dateText}}</text>
      </view>
      <view wx:if="{{day.hasDraw}}" class="recent-people">
        <view class="recent-person" wx:for="{{day.people}}" wx:for-item="person" wx:key="name">
          <view class="recent-person-head">
            <image src="{{person.image}}" mode="aspectFit" />
            <text>{{person.displayName}}</text>
          </view>
          <view class="recent-bears">
            <view class="recent-bear" wx:for="{{person.bears}}" wx:for-item="bear" wx:key="name">
              <image src="{{bear.image}}" mode="aspectFit" />
              <text>{{bear.name}}</text>
            </view>
          </view>
        </view>
      </view>
      <view wx:else class="empty muted">没有保存小熊结果</view>
    </view>
  </view>

  <view wx:if="{{pendingNotice}}" class="pending-card soft-card">
    <view class="pending-main">
      <view class="pending-avatar-wrap">
        <image class="pending-avatar" src="{{pendingNotice.applicantImage}}" mode="aspectFit" />
      </view>
      <view class="pending-copy">
        <view class="pending-headline">
          <text class="pending-title">{{pendingNotice.title}}</text>
          <text class="pending-highlight">{{pendingNotice.applicantDisplay || pendingNotice.applicant}}</text>
        </view>
        <text class="pending-detail">{{pendingNotice.detail}}</text>
      </view>
    </view>
    <view wx:if="{{pendingNotice.mine}}" class="pending-actions">
      <view class="pending-button cancel" bindtap="cancelPending">取消</view>
      <view class="pending-button wait">无需对方同意</view>
    </view>
    <view wx:else class="pending-actions">
      <view class="pending-button reject" bindtap="rejectPending">拒绝</view>
      <view class="pending-button approve" bindtap="approvePending">同意</view>
    </view>
  </view>

  <view class="audit soft-card">
    <text class="muted">防作弊记录 · 每日记录</text>
    <view class="audit-line" wx:for="{{todayActions}}" wx:key="id">
      <text>{{item.time}} {{item.person}} {{item.action}} {{item.detail}}</text>
    </view>
    <view wx:if="{{!todayActions.length}}" class="empty muted">今天还没有操作</view>
  </view>

  <view wx:if="{{showExchangePicker}}" class="picker-mask">
    <view class="picker-sheet soft-card">
      <view class="picker-top">
      <text class="picker-title">{{exchangePickerTitle}}</text>
        <view class="picker-close" bindtap="closeExchangePicker">×</view>
      </view>
      <text wx:if="{{exchangePickerMode === 'exchange'}}" class="picker-note">会消耗 1 次申请兑换机会，并直接完成兑换。</text>
      <view class="picker-grid">
        <view class="picker-bear {{auctionTargetBear === item.name ? 'active' : ''}}" wx:for="{{exchangeChoices}}" wx:key="name" data-name="{{item.name}}" bindtap="chooseExchangeBear">
          <image src="{{item.image}}" mode="aspectFit" />
          <text>{{item.name}}</text>
        </view>
      </view>
      <button wx:if="{{exchangePickerMode === 'exchange'}}" class="button" bindtap="confirmExchange">确认直接兑换</button>
    </view>
  </view>

  <view wx:if="{{showWishPicker}}" class="picker-mask">
    <view class="picker-sheet soft-card">
      <view class="picker-top">
        <text class="picker-title">选择心愿小熊</text>
        <view class="picker-close" bindtap="closeWishPicker">×</view>
      </view>
      <view class="picker-grid two-column">
        <view class="picker-bear {{item.active ? 'active' : ''}}" wx:for="{{wishChoices}}" wx:key="name" data-name="{{item.name}}" bindtap="chooseWishBear">
          <image src="{{item.image}}" mode="aspectFit" />
          <text>{{item.name}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
