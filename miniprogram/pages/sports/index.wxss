.head {
  margin-bottom: 22rpx;
}

.title {
  margin-top: 10rpx;
  font-size: 48rpx;
  font-weight: 800;
}

.calendar-card {
  margin-top: 24rpx;
  padding: 28rpx 24rpx;
}

.calendar-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22rpx;
}

.month-title {
  color: #4d3a32;
  font-size: 34rpx;
  font-weight: 700;
}

.month-button {
  width: 54rpx;
  height: 54rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #f8f0e3;
  color: #9b7b58;
  font-size: 38rpx;
  line-height: 1;
}

.week-row {
  display: flex;
  color: #a3958a;
  font-size: 25rpx;
  line-height: 1;
}

.week-row text {
  width: 14.285%;
  text-align: center;
}

.month-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 18rpx;
}

.day-cell {
  position: relative;
  box-sizing: border-box;
  width: 14.285%;
  height: 68rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #6a554c;
  font-size: 27rpx;
}

.day-cell text {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 50rpx;
  height: 50rpx;
  border-radius: 18rpx;
}

.day-cell.today text {
  background: #f7ead5;
}

.day-cell.selected text {
  background: #dfa044;
  color: #fff;
}

.empty-day {
  pointer-events: none;
}

.record-dot,
.steps-dot {
  position: absolute;
  bottom: 4rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
}

.record-dot {
  left: 50%;
  transform: translateX(-9rpx);
  background: #82b58a;
}

.steps-dot {
  left: 50%;
  transform: translateX(7rpx);
  background: #dfa044;
}

.section {
  margin-top: 24rpx;
  padding: 28rpx;
}

.section-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.section-title {
  display: block;
  color: #4d3a32;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.25;
}

.section-note {
  display: block;
  margin-top: 8rpx;
  color: #9a8c81;
  font-size: 25rpx;
  line-height: 1.35;
}

.small-button {
  flex: 0 0 auto;
  min-width: 144rpx;
  height: 62rpx;
  margin: 0;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #ffe6b9;
  color: #8a6130;
  font-size: 25rpx;
  line-height: 62rpx;
}

.small-button::after {
  border: 0;
}

.person-switch {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-top: 18rpx;
}

.person-pill {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 18rpx;
  border-radius: 28rpx;
  background: #fffaf1;
  font-size: 27rpx;
}

.person-pill.active {
  background: #ffe6b9;
}

.person-pill image {
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  background:
    radial-gradient(circle at 35% 28%, rgba(255, 255, 255, 0.9), transparent 38%),
    linear-gradient(135deg, #fff7e5 0%, #eaf6ef 100%);
}

.person-pill-copy {
  min-width: 0;
  display: flex;
  flex-direction: column;
  line-height: 1.25;
}

.tag-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx 14rpx;
  margin-top: 20rpx;
  padding: 0 18rpx;
}

.tag {
  box-sizing: border-box;
  display: inline-block;
  justify-self: center;
  width: auto;
  max-width: 100%;
  min-width: 0;
  margin: 0;
  padding: 0 18rpx;
  height: 56rpx;
  border-radius: 999rpx;
  background: #edf7f9;
  color: #5b6c70;
  font-size: 24rpx;
  line-height: 56rpx;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tag::after {
  border: 0;
}

.input {
  box-sizing: border-box;
  width: 100%;
  min-height: 84rpx;
  margin-top: 16rpx;
  padding: 0 24rpx;
  border-radius: 20rpx;
  background: #f8f0e3;
  color: #4d3a32;
  font-size: 29rpx;
}

.button {
  margin-top: 18rpx;
}

.button.secondary {
  background: #82b58a;
}

.steps-list {
  display: grid;
  gap: 12rpx;
  margin-top: 18rpx;
}

.step-row,
.sport-log {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  min-height: 62rpx;
  color: #5b4942;
  font-size: 27rpx;
}

.step-row > view {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.step-row image {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
}

.step-row.winner {
  color: #8a6130;
  font-weight: 800;
}

.record-card {
  background: #f3ebdc;
  box-shadow: none;
}

.record-card .section-title {
  color: #94877d;
  font-size: 26rpx;
  font-weight: 400;
}

.empty {
  margin-top: 16rpx;
}
