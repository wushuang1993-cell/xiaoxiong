<view class="screen calendar-screen">
  <view class="head">
    <text class="muted">{{dateText}}</text>
    <view class="title">家务日历</view>
  </view>

  <view class="soft-card calendar-card" bindtouchstart="onCalendarTouchStart" bindtouchend="onCalendarTouchEnd">
    <view class="calendar-top">
      <view class="month-button" bindtap="prevMonth">‹</view>
      <view class="month-title">{{calendarMonthText}}</view>
      <view class="month-button" bindtap="nextMonth">›</view>
    </view>
    <view class="week-row">
      <text wx:for="{{weekDays}}" wx:key="*this">{{item}}</text>
    </view>
    <view class="month-grid">
      <view
        class="day-cell {{item.isEmpty ? 'empty-day' : ''}} {{item.isToday ? 'today' : ''}} {{item.isSelected ? 'selected' : ''}}"
        wx:for="{{calendarDays}}"
        wx:key="key"
        data-day="{{item.day}}"
        bindtap="selectDay"
      >
        <text wx:if="{{!item.isEmpty}}">{{item.day}}</text>
        <view wx:if="{{item.hasLogs}}" class="record-dot"></view>
        <view wx:if="{{item.hasDraw}}" class="draw-dot"></view>
      </view>
    </view>
  </view>

  <view class="soft-card section">
    <text class="section-title">记录类型</text>
    <view class="person-switch in-records">
      <view class="person-pill {{selectedPerson === item.name ? 'active' : ''}}" wx:for="{{state.people}}" wx:key="name" data-name="{{item.name}}" bindtap="selectPerson">
        <image src="{{item.image}}" mode="aspectFit" />
        <view class="person-pill-copy">
          <text>{{item.displayName || item.name}}</text>
          <text class="muted">重抽 {{item.redrawChances || 0}} · 兑换 {{item.exchangeChances || 0}}</text>
        </view>
      </view>
    </view>
    <view class="tag-grid">
      <button class="tag {{item.tone}}" wx:for="{{quickRules}}" wx:key="label" data-label="{{item.label}}" data-delta="{{item.delta}}" data-credit-type="{{item.creditType}}" bindtap="addLog">{{item.label}}</button>
    </view>
  </view>

  <view class="soft-card section record-card">
    <text class="section-title">当天小熊</text>
    <view class="draw-history-person" wx:for="{{selectedDrawPeople}}" wx:key="name">
      <view class="draw-history-head">
        <image src="{{item.image}}" mode="aspectFit" />
        <text>{{item.displayName}}</text>
      </view>
      <view class="draw-history-bears">
        <view class="history-bear" wx:for="{{item.bears}}" wx:for-item="bear" wx:key="name">
          <image src="{{bear.image}}" mode="aspectFit" />
          <text>{{bear.name}}</text>
        </view>
        <text wx:if="{{!item.bears.length}}" class="muted">这一天没有保存小熊结果</text>
      </view>
    </view>
    <text class="section-title">{{selectedDateTitle}}</text>
    <view class="log-line {{item.delta < 0 ? 'minus-log' : ''}}" wx:for="{{todayLogs}}" wx:key="index">
      <text>{{item.displayPerson || item.person}} · {{item.type}}</text>
      <text>{{item.deltaText}}</text>
    </view>
    <view wx:if="{{!todayLogs.length}}" class="muted empty">今天还没有记录</view>
  </view>
</view>
